<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Someone is interested in your facility</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f4f6f8;
        font-family: Arial, sans-serif;
        color: #1f2937;
      }
      .wrap {
        width: 100%;
        padding: 28px 14px;
      }
      .card {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
      }
      .header {
        background: #132329;
        color: #ffffff;
        text-align: center;
        padding: 20px;
        font-size: 22px;
        font-weight: 700;
      }
      .content {
        padding: 24px;
        font-size: 14px;
        line-height: 1.6;
      }
      .box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px;
        margin: 16px 0;
      }
      .label {
        color: #6b7280;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin: 0 0 4px;
      }
      .value {
        margin: 0 0 12px;
        word-break: break-word;
      }
      .value:last-child {
        margin-bottom: 0;
      }
      a {
        color: #00b8d9;
      }
      .cta-wrap {
        text-align: center;
        margin: 20px 0 8px;
      }
      .button {
        display: inline-block;
        background-color: #00b8d9;
        color: #ffffff !important;
        padding: 12px 28px;
        text-decoration: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
      }
      .button-secondary {
        display: inline-block;
        background-color: #132329;
        color: #ffffff !important;
        padding: 12px 28px;
        text-decoration: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
      }
      .cta-note {
        text-align: center;
        font-size: 12px;
        color: #6b7280;
        margin: 0 0 8px;
      }
      .link-fallback {
        margin: 16px 0 4px;
        font-size: 12px;
        color: #6b7280;
      }
      .link {
        margin: 0 0 12px;
        word-break: break-all;
        font-size: 12px;
        color: #00b8d9;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="card">
        <div class="header">CareMatch</div>
        <div class="content">
          <p>Hi <%= facilityName || "there" %>,</p>

          <p>
            Someone is interested in your facility! You can see their information below
            and message them in your Carematch profile.
          </p>

          <div class="box">
            <p class="label">Name</p>
            <p class="value"><%= userName %></p>

            <% if (userEmail) { %>
            <p class="label">Email</p>
            <p class="value">
              <a href="mailto:<%= userEmail %>"><%= userEmail %></a>
            </p>
            <% } %>

            <% if (sentAt) { %>
            <p class="label">Time</p>
            <p class="value"><%= sentAt %></p>
            <% } %>
          </div>

          <% if (loginUrl) { %>
          <p class="cta-note">Sign in to your CareMatch facility account to follow up.</p>
          <div class="cta-wrap">
            <a class="button-secondary" href="<%= loginUrl %>" target="_blank" rel="noopener noreferrer">
              Sign In
            </a>
          </div>
          <p class="link-fallback">Sign in link:</p>
          <p class="link"><%= loginUrl %></p>
          <% } %>

          <p>
            Best,<br />
            Carematch
          </p>
        </div>
      </div>
    </div>
    <% if (trackingPixelUrl) { %>
    <img
      src="<%= trackingPixelUrl %>"
      width="1"
      height="1"
      alt=""
      style="display:block;width:1px;height:1px;border:0;"
    />
    <% } %>
  </body>
</html>
